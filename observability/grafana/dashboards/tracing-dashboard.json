{
  "title": "Distributed Tracing Dashboard",
  "uid": "distributed-tracing-dashboard",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "request latency",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "trace volume",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "tempo",
        "uid": "Tempo"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{}"
        }
      ],
      "description": "TODO: tune TraceQL aggregation for your Tempo version"
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "service dependency graph",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "Tempo"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "serviceMap",
          "query": "{}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "slow endpoints",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "failed traces",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "tempo",
        "uid": "Tempo"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ status = error }"
        }
      ],
      "description": "TODO: adjust depending on available status tags"
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "span duration",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "tempo",
        "uid": "Tempo"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{}"
        }
      ],
      "description": "TODO: use duration histogram once configured"
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "top latency contributors",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(job) (histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "trace-linked incidents",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(incidents_created_total[10m])"
        }
      ],
      "description": "TODO: enrich with explicit incident_trace_links_total metric"
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}