{
  "title": "AIOps Operational Intelligence",
  "uid": "aiops-operational-intelligence",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Incident rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(incidents_created_total[5m])"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "AI-analyzed incidents",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(aiops_incidents_analyzed_total[5m])"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Severity distribution",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(severity) (incidents_created_total)"
        }
      ],
      "description": "TODO: replace with canonical severity metric labels if needed"
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Top affected services",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(component) (incident_created_total)"
        }
      ],
      "description": "TODO: verify metric name/cardinality in IMS"
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Incident trends",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(incidents_created_total[1h])"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Error spikes",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(http_requests_total{status=~\"5..\"}[5m])"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "AI remediation summaries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aiops_analysis_duration_seconds_count"
        }
      ],
      "description": "TODO: add structured remediation summary metrics/log extraction in future phases"
    }
  ]
}