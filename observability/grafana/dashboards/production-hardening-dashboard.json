{
  "title": "Production Hardening Dashboard",
  "uid": "production-hardening-dashboard",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HPA scaling events",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(changes(kube_horizontalpodautoscaler_status_current_replicas[5m]))"
        }
      ],
      "description": "TODO: verify metric availability from kube-state-metrics"
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "pod counts",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(kube_pod_info)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "node counts",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(kube_node_info)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU utilization",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(rate(container_cpu_usage_seconds_total[5m]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "memory utilization",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(container_memory_usage_bytes)"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "cluster pressure",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"false\"})"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "autoscaling activity",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_horizontalpodautoscaler_status_desired_replicas)"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "restart frequency",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(kube_pod_container_status_restarts_total[10m])"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "deployment availability",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_deployment_status_replicas_available)"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "node health",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "estimated infrastructure cost trends",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(kube_node_info) * 0.12"
        }
      ],
      "description": "TODO: replace with real cloud cost metrics integration"
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}