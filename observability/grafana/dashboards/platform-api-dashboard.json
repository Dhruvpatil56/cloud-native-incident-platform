{
  "title": "Platform API Operations Dashboard",
  "uid": "platform-api-operations-dashboard",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API request volume",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"platform-api\"}[5m]))"
        }
      ],
      "description": "TODO: ensure platform-api metrics are scraped"
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "deployment sync requests",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(platform_api_deployment_sync_total[5m]))"
        }
      ],
      "description": "TODO: emit explicit metric from /deployments/sync"
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "incident API usage",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"platform-api\",path=~\"/incidents.*\"}[5m]))"
        }
      ],
      "description": "TODO: adjust labels based on instrumentation"
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "service catalog lookups",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(platform_api_service_catalog_lookups_total[5m]))"
        }
      ],
      "description": "TODO: add metric counter for catalog lookups"
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "failed API requests",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"platform-api\",status=~\"4..|5..\"}[5m]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "audit activity",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"fluent-bit\"} |= \"AUDIT action=\" [5m]))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "AI/AIOps API calls",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"platform-api\",path=~\"/aiops.*\"}[5m]))"
        }
      ],
      "description": "TODO: verify path label availability"
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}